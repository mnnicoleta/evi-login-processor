      "link": null,
      "locked": false,
      "text": "Consumer group 1: subscribed to TOPIC \"customer-login\":\nread messages and performs REST requests  (+3 retires) \nand in the end publishes result on TOPIC \"login-tracking-\nresult\" (message = customer-login message + \nrequestResult)",
      "fontSize": 16.286402054758593,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "ZMtCCyEbTHOX3ZsBSL64Y",
      "originalText": "Consumer group 1: subscribed to TOPIC \"customer-login\": read messages and performs REST requests  (+3 retires) and in the end publishes result on TOPIC \"login-tracking-result\" (message = customer-login message + requestResult)",
      "autoResize": true,
      "lineHeight": 1.25,
      "baseline": 96
